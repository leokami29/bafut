# --- Activas (las que lee la app en el entorno actual) ---
# Local/staging: apuntá al proyecto de staging. Prod Railway: proyecto prod.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Local: http://localhost:3005 — Producción (Railway): https://bafut.macuttech.com
# Nunca localhost:8080 (puerto interno de Railway, no es la URL pública).
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# --- Staging (plantilla / secret store; la app NO las lee en runtime) ---
# Proyecto Supabase separado para probar migraciones antes de prod.
# Ver docs/staging.md. Dejá placeholders hasta crear el proyecto en la nube.
STAGING_SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
STAGING_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
STAGING_SUPABASE_PROJECT_REF=YOUR_STAGING_REF
STAGING_SITE_URL=https://staging.example.com

# Donaciones voluntarias (opcional; si falta una, no se muestra)
NEXT_PUBLIC_DONATE_KOFI=
NEXT_PUBLIC_DONATE_GITHUB=
NEXT_PUBLIC_DONATE_NEQUI=

# Pago manual Premium (dueños de cancha). Si falta canal, el form avisa.
NEXT_PUBLIC_PREMIUM_PRICE_COP=49900
NEXT_PUBLIC_PREMIUM_DURATION_DAYS=30
NEXT_PUBLIC_PREMIUM_NEQUI=
NEXT_PUBLIC_PREMIUM_BANK_NAME=
NEXT_PUBLIC_PREMIUM_BANK_ACCOUNT=
NEXT_PUBLIC_PREMIUM_BANK_HOLDER=

# Contacto para dueños de cancha (opcional; si falta, no se muestra el botón)
NEXT_PUBLIC_VENUE_OWNER_WHATSAPP=
NEXT_PUBLIC_VENUE_OWNER_EMAIL=

# Google Analytics 4 (opcional)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Cron jobs (Bearer CRON_SECRET). Distinto en staging vs prod.
# Generar: openssl rand -hex 32
# Endpoints: /api/cron/weekly-matches , /api/cron/push-alerts , /api/cron/renewal-reminders
CRON_SECRET=

# Service role (solo server / cron). Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push VAPID (fase C; opcionales hasta activar push_alerts)
# Generar: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@bafut.app

# Feature flags (opcional). Si está seteado, pisa la DB.
# Kill-switch sin redeploy: UPDATE feature_flags SET enabled=false WHERE key='push_alerts';
# FEATURE_PREMIUM_PAYWALL=1
# FEATURE_PUSH_ALERTS=1
# FEATURE_DIRECTORY_PREMIUM_BOOST=1

# Renovaciones email solo con Resend (NO SMTP free de Supabase).
# RESEND_API_KEY=
# RESEND_FROM=BaFut <noreply@tudominio.com>
